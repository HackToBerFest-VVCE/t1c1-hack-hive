# ==============================================================================
# LabSense AI — Environment Configuration Template (.env.example)
# Copy this file to .env and populate with your credentials.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# ==============================================================================
# CATEGORY 1: REQUIRED NOW FOR THE FRONTEND SUPABASE CLIENT (Vite Client-Side)
# These variables are exposed to the browser to initialize the Supabase client.
# Obtain from: Supabase Dashboard -> Project Settings -> API
# ==============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Key (public browser key)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder


# ==============================================================================
# CATEGORY 2: REQUIRED FOR LIVE GEMMA INFERENCE (FastAPI Server-Side Only)
# Never prefix with VITE_ or expose to the frontend.
# Obtain from: Google AI Studio (https://aistudio.google.com/)
# ==============================================================================

# Google AI Studio / Gemini API Key used by backend/services/gemma_service.py
GEMINI_API_KEY=your_gemini_api_key_placeholder


# ==============================================================================
# CATEGORY 3: REQUIRED ONLY IF THE BACKEND USES SUPABASE (Server-Side)
# Currently, the FastAPI backend routes handle circuit troubleshooting and simulation
# computations independently. These variables are reserved if the Python backend
# directly interfaces with Supabase.
# ==============================================================================

# Supabase Project URL for server-side Python requests
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon key for server-side Python requests
SUPABASE_ANON_KEY=your_anon_key_placeholder


# ==============================================================================
# CATEGORY 4: OPTIONAL RUNTIME SETTINGS & CURRENTLY UNUSED VARIABLES
# Sensible defaults are already provided in the codebase.
# ==============================================================================

# Frontend: FastAPI Backend intelligence endpoint (defaults to http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Backend: Server Runtime Environment and Port bindings
APP_ENV=development
PORT=8000
HOST=127.0.0.1

# Backend: Gemma Multimodal Model Identifiers
GEMMA_MODEL_ID=gemma-4-31b-it
GEMMA_FALLBACK_MODEL_ID=gemma-4-26b-a4b-it

# Backend: Security bootstrap code for elevating verified instructors
INSTRUCTOR_INVITE_CODE=LABSENSE-INST-2026

# Backend: Supabase Service Role Key (NEVER use in frontend; optional for server admin)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_placeholder
